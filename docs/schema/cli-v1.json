{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hoshi CLI response",
  "type": "object",
  "required": ["schema_version", "ok"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1, "description": "CLI JSON schema version. Bump on breaking changes." },
    "ok": { "type": "boolean" },
    "message": { "type": "string" },
    "now": { "type": "integer", "minimum": 0 },
    "deterministic": { "type": "boolean" },
    "save_schema": { "type": "integer" },
    "resources": {
      "type": "object",
      "required": ["metal", "crystal", "deuterium"],
      "properties": {
        "metal": { "type": "number" },
        "crystal": { "type": "number" },
        "deuterium": { "type": "number" }
      }
    },
    "rates": { "type": "object" },
    "energy": { "type": "object" },
    "waste": {
      "type": "object",
      "description": "Instantaneous heat and pollution load versus sink, plus unrest and the warning flag."
    },
    "buildings": { "type": "object" },
    "build_queue": { "type": "array" },
    "research": { "type": "object" },
    "fleet": { "type": "object" },
    "defences": {
      "type": "object",
      "description": "Home planet defence counts and dome/station levels."
    },
    "missions": { "type": "array" },
    "spy_reports": {
      "type": "array",
      "description": "Stored spy reports with age_secs. Each outpost also carries its latest report."
    },
    "planets": { "type": "array" },
    "events": { "type": "array" },
    "raid": {
      "type": ["object", "null"],
      "description": "Visible raid countdown, matching the TUI overview."
    },
    "prestige": {
      "type": "object",
      "description": "Meta currency, current run and owned bonuses."
    },
    "laws": {
      "type": "array",
      "description": "Proposed, enacted and repealed laws with approvals and latest expected vs measured samples."
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["invalid", "refused", "locked", "internal"] },
        "message": { "type": "string" }
      }
    }
  }
}
