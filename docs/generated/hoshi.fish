# Generated by hoshi help --completions fish
function __hoshi_context
  set -l tokens (commandline -opc)
  set -e tokens[1]
  set -l context
  set -l skip_value 0
  for word in $tokens
    if test $skip_value -eq 1
      set skip_value 0
      continue
    end
    switch $word
      case --save --balance --seed --bind --config
        set skip_value 1
      case '-*'
      case '*'
        set -a context $word
    end
  end
  set -l current (string join ' ' -- $context)
  test "$current" = "$argv[1]"
end
